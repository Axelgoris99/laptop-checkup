# Copy to .env and fill in. Used by deploy.sh.
DEPLOY_HOST=user@example.com           # ssh target (or ~/.ssh/config alias)
DEPLOY_DIR=/srv/laptop-checkup         # built site on the server; Caddy must be able to read it
DOMAIN=checkup.example.com
CADDY_SITES_DIR=caddy                  # folder imported by your Caddyfile (relative to ssh home)
CADDY_CONTAINER=caddy                  # Caddy's docker container name
